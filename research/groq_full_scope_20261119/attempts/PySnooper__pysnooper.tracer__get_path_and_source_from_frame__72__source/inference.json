        "content": "```python\nimport builtins\nimport inspect\nimport os\nimport sys\nimport types\nimport pytest\n\nfrom pysnooper.tracer import get_path_and_source_from_frame, UnavailableSource\n\n\ndef _create_function_in_file(tmp_path, filename, code):\n    \"\"\"Create a temporary Python file containing a function and return its frame.\"\"\"\n    file_path = tmp_path / filename\n    file_path.write_text(code)\n    # Import the module to get a frame\n    module_name = f\"tmp_{filename.replace('.py', '')}\"\n    spec = types.ModuleType(module_name)\n    with open(file_path, \"rb\") as fp:\n        exec(compile(fp.read(), str(file_path), \"exec\"), spec.__dict__)\n    # Retrieve the function object\n    func = getattr(spec, \"test_func\")\n    # Return the frame of the function when called\n    return func.__code__, file_path\n\n\ndef test_get_path_and_source_from_frame_reads_file(tmp_path):\n    \"\"\"Normal case: source is read from a real file.\"\"\"\n    code = \"def test_func():\\n    return 42\\n\"\n    code_obj, file_path = _create_function_in_file(tmp_path, \"normal.py\", code)\n    frame = types.FrameType(\n        None, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {